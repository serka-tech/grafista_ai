# ─────────────────────────────────────────
# Grafista AI Studio — STAGING Environment (Docker Compose skeleton)
# ─────────────────────────────────────────
# This file documents ONLY the staging-specific deltas/defaults vs the full,
# category-by-category reference in the root `.env.example` (read that file
# first for what every variable means — it is not duplicated line-by-line
# here). Copy this file to `.env.staging` before running `pnpm run
# staging:up` — `.env.staging` is gitignored, NEVER commit the filled copy.
#
# No real secret value is present anywhere in this file. Every value below
# is either: a safe default, a disposable local-only placeholder scoped to
# the Compose network (clearly labeled), or an intentionally-blank field you
# must fill in yourself before first use.

# ── Database ──
# Host is the Compose SERVICE NAME "postgres" (Docker's internal DNS),
# NOT "localhost" — this only resolves when `api` runs INSIDE the compose
# network defined by docker-compose.staging.yml. Credentials below match
# that file's `postgres` service block exactly (disposable, local-only, not
# reachable outside the compose network — no `ports:` mapping on postgres
# by default). Change both sides together if you edit one.
DATABASE_URL=postgresql://grafista:grafista_staging_local_only@postgres:5432/grafista
PGVECTOR_ENABLED=true

# ── Storage ──
# CHOICE: STORAGE_PROVIDER=local for this first skeleton — writes inside the
# `api` container's apps/api/uploads/ directory, which is NOT persisted
# across `docker compose down`/recreate (no volume is mounted for it, see
# docker-compose.staging.yml's comment — this is a disposable validation
# loop, not a durable store). To validate the real S3-compatible path in
# staging (recommended eventually, per docs/deployment-runbook.md §2/§3),
# add a `minio` service to docker-compose.staging.yml (or point at a real S3
# bucket) and switch these to STORAGE_PROVIDER=s3 + fill the S3_* vars —
# NOT done in this first skeleton, see docs/staging-compose.md "known gaps".
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Renderer ──
# CHOICE: "fake" (default here) = zero Chromium risk, deterministic output,
# the safest possible first validation loop — matches local dev's own
# demo-mode convention. Set to "playwright" to exercise the real Chromium
# render path instead — apps/api/Dockerfile installs Chromium in the image
# either way, so flipping this is a pure env change, no image rebuild
# required.
RENDERER_PROVIDER=fake

# ── Render queue / worker ──
# CHOICE: RENDER_QUEUE_ENABLED=true here as a deliberate STAGING TRIAL, per
# docs/deployment-runbook.md §3/§7 — this is the first real environment
# (outside of tests) where worker heartbeat / stale-lock-sweep behavior gets
# observed running continuously in a container rather than a laptop process.
# Set to "false" if you just want the plain synchronous render path first.
RENDER_QUEUE_ENABLED=true
RENDER_WORKER_ID=
RENDER_JOB_MAX_ATTEMPTS=3
RENDER_JOB_BASE_DELAY_MS=2000
RENDER_WORKER_POLL_INTERVAL_MS=3000
RENDER_JOB_STALE_LOCK_MS=900000

# ── AI providers ──
# CHOICE: AI_DEFAULT_PROVIDER=fake (below) for a safe first bring-up with
# zero network calls and zero cost — any dummy string works for
# OPENAI_API_KEY/ANTHROPIC_API_KEY in this mode (startup validation is
# presence-only, see apps/api/src/config/env.ts). To validate real providers
# in staging, replace AI_DEFAULT_PROVIDER with "openai"/"claude", fill real
# keys, and run `pnpm --filter @grafista/api run smoke:providers` in a
# controlled, limited way (this costs real money/quota — see
# docs/deployment-runbook.md §3). Never put a real key directly in this
# EXAMPLE file — only in your own untracked `.env.staging`.
OPENAI_API_KEY=sk-staging-demo-not-real
ANTHROPIC_API_KEY=sk-ant-staging-demo-not-real
GEMINI_API_KEY=
KIE_AI_API_KEY=
KIE_AI_BASE_URL=
KIE_AI_IMAGE_MODEL=
KIE_AI_TIMEOUT_MS=
KIE_AI_POLL_INTERVAL_MS=
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=

AI_DEFAULT_PROVIDER=fake
DEFAULT_TEXT_PROVIDER=openai
DEFAULT_VISION_PROVIDER=openai
OPENAI_VISION_MODEL=gpt-4o
DEFAULT_IMAGE_PROVIDER=openai
AI_TIMEOUT_MS=30000

# ── App ports/public URLs ──
# API_HOST must stay 0.0.0.0 inside the container (not 127.0.0.1) so
# Docker's port mapping ("4000:4000" in docker-compose.staging.yml) can
# actually reach the process.
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Auth ──
# AUTH_SECRET is left BLANK on purpose — this is the one field in this file
# that is NOT a safe placeholder. Fill it with a real generated value before
# `pnpm run staging:up` (`openssl rand -hex 32`) — the API fails fast at
# boot if it is missing or under 16 characters (apps/api/src/config/env.ts).
AUTH_SECRET=
COOKIE_SECURE=false

# ── Admin seed ──
# Only read by `db:seed-admin` (run manually inside the container, see
# docs/staging-compose.md) — not required for the API process itself to
# start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Misc ──
UPLOAD_MAX_SIZE_MB=50
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,image/svg+xml,application/pdf,application/x-photoshop,image/vnd.adobe.photoshop,application/zip,application/x-zip-compressed
PHOTOSHOP_WORKER_URL=http://localhost:5000
PHOTOSHOP_WORKER_ENABLED=false
LOG_LEVEL=info
NODE_ENV=production
