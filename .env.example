# ─────────────────────────────────────────
# Grafista AI Studio — Environment Variables
# ─────────────────────────────────────────

# Database
# DATABASE_URL: required — API fails fast at startup if missing or invalid
DATABASE_URL=postgresql://user:password@localhost:5432/grafista
PGVECTOR_ENABLED=true

# Storage (S3-Compatible) — Phase 2 Step 3
# Production note (Step 9): "local" has no backup story and should not be used in
# production — see docs/backup-restore-runbook.md for the persistence inventory,
# managed Postgres/S3 decision criteria, and backup/restore procedure.
# STORAGE_PROVIDER: "s3" or "local". Defaults to "local" (writes to apps/api/uploads/) when unset.
# Set to "s3" to use the S3-compatible client below — there is no silent fallback to local on failure.
STORAGE_PROVIDER=local
# S3_ENDPOINT: custom endpoint for S3-compatible providers (MinIO/R2/Backblaze). Leave unset for real AWS S3.
# MUST be a full absolute URL INCLUDING the https:// scheme — a bare host (e.g.
# "<id>.r2.cloudflarestorage.com") makes the AWS SDK throw "Invalid URL" only at
# first request. Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# (account-level endpoint, NOT bucket-specific; pair with S3_REGION=auto).
S3_ENDPOINT=
# S3_REGION: AWS region (or the region your S3-compatible provider expects). Required when STORAGE_PROVIDER=s3.
S3_REGION=us-east-1
# S3_BUCKET: bucket name that stores brand assets and design references. Required when STORAGE_PROVIDER=s3.
S3_BUCKET=grafista-assets
# S3_ACCESS_KEY_ID: access key for the bucket above. Required when STORAGE_PROVIDER=s3.
S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY: secret key for the bucket above. Required when STORAGE_PROVIDER=s3. Never commit a real value.
S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE: set to "true" for MinIO-style endpoints that need path-style addressing (bucket.region.host/key).
S3_FORCE_PATH_STYLE=false
# S3_SIGNED_URL_EXPIRY_SECONDS: validity window (seconds) for presigned download URLs the API
# hands out (via a 302 redirect after the auth/RBAC check). Optional; defaults to 300. Keep it
# short — the authenticated route re-mints a fresh URL on every request.
S3_SIGNED_URL_EXPIRY_SECONDS=300

# Template Render Engine (Phase 2 Step 9A)
# RENDERER_PROVIDER: "playwright" or "fake". Defaults to "playwright" when unset. Set to "fake" for
# environments without Chromium available (the fake adapter is deterministic and does no real
# rendering — see apps/api/src/render/adapters/fake-adapter.ts). The test suite always uses "fake"
# (see apps/api/vitest.config.ts) regardless of this value.
RENDERER_PROVIDER=playwright

# Render Queue / Worker (Phase 3 Step 5A) — all optional, fully backward
# compatible when unset: renders stay fully synchronous (today's behavior).
# RENDER_QUEUE_ENABLED: "true" to move POST /production-jobs/:id/render onto
# the Postgres-backed queue (202 + a 'queued' job, processed by the
# in-process polling worker started from index.ts) instead of running the
# whole render pipeline inline. Defaults to "false"/unset.
RENDER_QUEUE_ENABLED=false
# RENDER_WORKER_ID: identifies this process in render_jobs.locked_by. Defaults to "render-worker-<pid>".
RENDER_WORKER_ID=
# RENDER_JOB_MAX_ATTEMPTS: how many times the worker retries a retryable render failure before giving up ('failed'). Defaults to 3.
RENDER_JOB_MAX_ATTEMPTS=3
# RENDER_JOB_BASE_DELAY_MS: base backoff delay (ms) before a retry becomes eligible again; doubles per attempt. Defaults to 2000.
RENDER_JOB_BASE_DELAY_MS=2000
# RENDER_WORKER_POLL_INTERVAL_MS: how often (ms) the in-process worker polls for claimable jobs. Defaults to 3000.
RENDER_WORKER_POLL_INTERVAL_MS=3000
# RENDER_JOB_STALE_LOCK_MS: how long (ms) a 'rendering' job can stay locked without
# progress before the stale-lock sweep recovers it (back to 'pending' if attempts
# remain, else terminal 'failed'). See GET /api/health/ready's renderQueue check and
# apps/api/src/services/render-worker.ts's sweepStaleRenderLocks(). Defaults to 900000 (15 min).
RENDER_JOB_STALE_LOCK_MS=900000

# API Security (Production go-live M2.2)
# TRUST_PROXY: how Express computes req.ip behind a reverse proxy. On Render (one
# proxy hop) set TRUST_PROXY=1 so req.ip is the REAL client IP the rate limiter keys
# on — WITHOUT this, all clients share the proxy's IP (over-limiting) and a spoofed
# X-Forwarded-For could evade limits. Unset (default) = trust nothing (correct for
# direct/local). Accepts a hop count (e.g. 1) or any Express trust-proxy value.
TRUST_PROXY=
# --- rate limiting ---
# In-memory fixed-window limiter (apps/api/src/middleware/rate-limit.ts). ON by default;
# the whole test suite sets RATE_LIMIT_ENABLED=false. General limit applies to all /api
# routes (health probes excluded); the login route adds a stricter per-(IP+email) limit.
# RATE_LIMIT_ENABLED: only the literal "false" disables it.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS / RATE_LIMIT_MAX: general limiter window + max requests. Defaults 60000 / 300.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_WINDOW_MS / AUTH_RATE_LIMIT_MAX: strict login limiter. Defaults 60000 / 10.
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL: optional override for the Claude text model id. Leave empty to use the
# built-in default claude-opus-5 (DEFAULT_MODEL in packages/model-router/src/providers/claude.ts).
ANTHROPIC_MODEL=
KIE_AI_API_KEY=
# KIE_AI_BASE_URL: e.g. https://api.kie.ai (a trailing /api/v1 is tolerated). Required together with KIE_AI_API_KEY for the kie-ai image provider.
KIE_AI_BASE_URL=
# KIE_AI_IMAGE_MODEL: optional override for the Kie AI image model id. Leave empty to use the
# built-in default nano-banana-2 (KIE_DEFAULT_IMAGE_MODEL in packages/model-router/src/providers/kie-ai.ts).
KIE_AI_IMAGE_MODEL=
# KIE_AI_TIMEOUT_MS: overall createTask+poll budget in ms (optional, defaults to 180000).
KIE_AI_TIMEOUT_MS=
# KIE_AI_POLL_INTERVAL_MS: polling interval in ms (optional, defaults to 10000 — Kie asks for >=10s).
KIE_AI_POLL_INTERVAL_MS=

# Per-client AI image budget guard (Production go-live M2.1) — enforced in
# apps/api/src/services/visual-generation-budget.ts BEFORE any paid provider call.
# Count-based (KIE bills per task and returns no per-call cost): the guard counts a
# client's successfully-generated outputs this calendar month and multiplies by the
# per-image cost below. Over the ceiling -> 402 Payment Required, no provider call.
# CLIENT_MONTHLY_BUDGET_USD: monthly per-client ceiling in USD. UNSET = guard disabled
# (unchanged behavior). Set this before enabling real KIE in production.
CLIENT_MONTHLY_BUDGET_USD=
# KIE_IMAGE_COST_USD: assumed cost of one generated image (USD) for the budget math.
# Defaults to 0.05 when unset — set it to your provider's real per-image price.
KIE_IMAGE_COST_USD=
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=

# ─────────────────────────────────────────
# DEMO MODE (fully offline, no real AI keys)
# ─────────────────────────────────────────
# Set AI_DEFAULT_PROVIDER=fake to answer EVERY AI call (DesignDNA analysis, content
# ideas, layouts, Creative QA, visual generation) with deterministic canned responses
# from packages/model-router/src/providers/fake.ts — zero network, zero cost. This is
# the single switch; production behavior is unchanged unless it is set to "fake".
#
# Note: OPENAI_API_KEY and ANTHROPIC_API_KEY must STILL be non-empty at boot (startup
# validation only checks presence) — any dummy string works in demo mode, e.g.:
#   OPENAI_API_KEY=sk-demo-not-real
#   ANTHROPIC_API_KEY=sk-ant-demo-not-real
#   AI_DEFAULT_PROVIDER=fake
#
# Pair with RENDERER_PROVIDER=fake (above) for a fully offline demo without Chromium,
# or leave RENDERER_PROVIDER unset to get real Playwright PNG/JPG/PDF exports.
# Seed a demo-ready client (design references WITH image bytes) via:
#   pnpm --filter @grafista/api run db:seed-demo
# (after db:migrate + db:seed; create the login user with db:seed-admin).

# AI Router Defaults
# AI_DEFAULT_PROVIDER: required in Phase 1 — which provider content generation uses first (openai | claude | fake)
AI_DEFAULT_PROVIDER=openai
DEFAULT_TEXT_PROVIDER=openai
DEFAULT_VISION_PROVIDER=openai
# OPENAI_VISION_MODEL: model used for image (vision) requests, e.g. Design DNA style
# analysis. Optional — defaults to gpt-4o (already vision-capable) when unset.
OPENAI_VISION_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL: model used for OpenAI image GENERATION (Images API), the
# openai-provider counterpart to KIE_AI_IMAGE_MODEL. Optional — defaults to
# gpt-image-1 when unset. Only accepts sizes 1024x1024 / 1536x1024 / 1024x1536.
OPENAI_IMAGE_MODEL=gpt-image-1
DEFAULT_IMAGE_PROVIDER=openai
# Provider retry behavior (Phase 3 Step 3): failures are CLASSIFIED before retrying —
# transient (5xx/network) and rate-limit (429) and timeout errors get a limited retry
# with exponential backoff; auth (401/403), permanent (4xx) and missing-configuration
# errors fail fast without retry. AI_RETRY_BASE_DELAY_MS (optional) overrides the
# backoff base delay for ALL error kinds; set 0 to disable waiting (tests/CI).
# AI_RETRY_BASE_DELAY_MS=250
AI_TIMEOUT_MS=30000

# API Server
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication (required — API fails fast at startup if AUTH_SECRET is missing/short)
# AUTH_SECRET: used as the HMAC key when hashing session tokens before storing them in
# PostgreSQL. Generate a real one with: openssl rand -hex 32
AUTH_SECRET=
# COOKIE_SECURE: set to "true" in production (HTTPS only). Defaults to "false" for local dev.
COOKIE_SECURE=false
# ADMIN_EMAIL / ADMIN_PASSWORD: only read by `pnpm run db:seed-admin` to create the first
# OWNER user. Not required for the API server itself to start. Never commit real values —
# set them in your local .env only, and consider unsetting/rotating after the first seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Security
UPLOAD_MAX_SIZE_MB=50
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,image/svg+xml,application/pdf,application/x-photoshop,image/vnd.adobe.photoshop,application/zip,application/x-zip-compressed

# Photoshop Worker (Phase 2)
PHOTOSHOP_WORKER_URL=http://localhost:5000
PHOTOSHOP_WORKER_ENABLED=false

# Logging
# Note (Step 11): LOG_LEVEL and NODE_ENV are read by no code in this repo today
# (apps/api/src, apps/dashboard) — kept here as conventional Node/Next.js env vars,
# not because app code branches on them. See docs/managed-infrastructure-plan.md §4.
LOG_LEVEL=info
NODE_ENV=development

# CI diagnostics (Production Step 5) — opt-in request/response logging middleware,
# a no-op unless explicitly enabled. NEVER set in production. See
# apps/api/src/middleware/debug-routes.ts for full usage.
# CI_DEBUG_ROUTES: set to "1" to enable. Defaults to unset/off.
CI_DEBUG_ROUTES=
# CI_DEBUG_ROUTES_LOG_FILE: optional path to also append the diagnostic log to a file.
CI_DEBUG_ROUTES_LOG_FILE=
