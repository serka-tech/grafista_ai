# ─────────────────────────────────────────
# Grafista AI Studio — Environment Variables
# ─────────────────────────────────────────

# Database
# DATABASE_URL: required — API fails fast at startup if missing or invalid
DATABASE_URL=postgresql://user:password@localhost:5432/grafista
PGVECTOR_ENABLED=true

# Storage (S3-Compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=grafista-assets
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# AI Providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
KIE_AI_API_KEY=
KIE_AI_BASE_URL=
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=

# AI Router Defaults
# AI_DEFAULT_PROVIDER: required in Phase 1 — which provider content generation uses first (openai | claude)
AI_DEFAULT_PROVIDER=openai
DEFAULT_TEXT_PROVIDER=openai
DEFAULT_VISION_PROVIDER=openai
DEFAULT_IMAGE_PROVIDER=openai
AI_MAX_RETRIES=3
AI_TIMEOUT_MS=30000

# API Server
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGIN=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# Authentication (required — API fails fast at startup if AUTH_SECRET is missing/short)
# AUTH_SECRET: used as the HMAC key when hashing session tokens before storing them in
# PostgreSQL. Generate a real one with: openssl rand -hex 32
AUTH_SECRET=
# COOKIE_SECURE: set to "true" in production (HTTPS only). Defaults to "false" for local dev.
COOKIE_SECURE=false
# ADMIN_EMAIL / ADMIN_PASSWORD: only read by `pnpm run db:seed-admin` to create the first
# OWNER user. Not required for the API server itself to start. Never commit real values —
# set them in your local .env only, and consider unsetting/rotating after the first seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Security
UPLOAD_MAX_SIZE_MB=50
ALLOWED_FILE_TYPES=image/png,image/jpeg,image/webp,image/svg+xml,application/pdf,application/x-photoshop,image/vnd.adobe.photoshop,application/zip,application/x-zip-compressed

# Photoshop Worker (Phase 2)
PHOTOSHOP_WORKER_URL=http://localhost:5000
PHOTOSHOP_WORKER_ENABLED=false

# Logging
LOG_LEVEL=info
NODE_ENV=development
